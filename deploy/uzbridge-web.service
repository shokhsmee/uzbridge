[Unit]
Description=uzbridge web (gunicorn)
After=network.target postgresql.service redis-server.service

[Service]
User=uzbridge
Group=uzbridge
WorkingDirectory=/opt/uzbridge/backend
ExecStart=/opt/uzbridge/venv/bin/gunicorn config.wsgi -b 127.0.0.1:8110 -w 3 --timeout 60 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
