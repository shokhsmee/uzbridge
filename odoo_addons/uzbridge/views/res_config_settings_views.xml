<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.uzbridge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="uzbridge" string="uzbridge" name="uzbridge" groups="base.group_system">
                    <block title="Connection" name="uzbridge_connection">
                        <setting string="uzbridge account" help="API key from uzbridge → Developers. Payme, Click, Uzum and SMS keys stay in uzbridge.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="uzbridge_url" class="col-lg-3 o_light_label"/>
                                    <field name="uzbridge_url"/>
                                </div>
                                <div class="row">
                                    <label for="uzbridge_api_key" class="col-lg-3 o_light_label"/>
                                    <field name="uzbridge_api_key" password="True"/>
                                </div>
                                <div class="row mt8" invisible="not uzbridge_account">
                                    <span class="col-lg-3 o_light_label">Connected</span>
                                    <field name="uzbridge_account"/>
                                </div>
                                <div class="mt8">
                                    <button name="action_uzbridge_connect" type="object" class="btn-primary"
                                            string="Connect / check" icon="oi-arrow-right"/>
                                    <button name="action_uzbridge_disconnect" type="object" class="btn-link"
                                            string="Disconnect" invisible="not uzbridge_account"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="SMS through uzbridge" help="Every Odoo SMS goes through your Eskiz or Playmobile account instead of Odoo IAP.">
                            <field name="uzbridge_sms"/>
                            <div class="mt8" invisible="not uzbridge_sms">
                                <button name="action_uzbridge_sync_templates" type="object" class="btn-link"
                                        string="Sync approved SMS templates" icon="oi-arrow-right"/>
                                <button name="%(uzbridge_sms_template_action)d" type="action" class="btn-link"
                                        string="View templates" icon="oi-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
