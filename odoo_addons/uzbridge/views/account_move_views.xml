<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.uzbridge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_invoice_sent'][last()]" position="after">
                <button name="action_uzbridge_payment_link" type="object" string="Payme · Click · Uzum link"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_receipt') or payment_state in ('paid', 'in_payment')"/>
            </xpath>
        </field>
    </record>
</odoo>
