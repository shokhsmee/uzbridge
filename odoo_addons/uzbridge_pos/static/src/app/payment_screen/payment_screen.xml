<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="uzbridge_pos.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="inside">
            <div t-if="pos.config.uzbridge_link_enabled or pos.config.uzbridge_sms_enabled" class="d-flex flex-column flex-sm-row gap-1 w-100">
                <button t-if="pos.config.uzbridge_link_enabled" class="button btn btn-secondary btn-lg w-100 lh-lg text-truncate"
                        t-on-click="uzbridgeShowLink">
                    <i class="fa fa-link me-2" aria-hidden="true"/>Payment link
                </button>
                <button t-if="pos.config.uzbridge_sms_enabled" class="button btn btn-secondary btn-lg w-100 lh-lg text-truncate"
                        t-on-click="uzbridgeSendSms">
                    <i class="fa fa-commenting-o me-2" aria-hidden="true"/>Send SMS
                </button>
            </div>
        </xpath>
    </t>
</templates>
